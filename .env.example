#Kafka
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_TOPICS=[{"name": "note.created", "num_partitions": 1, "replication_factor": 1}, {"name": "note.deleted", "num_partitions": 1, "replication_factor": 1}]

