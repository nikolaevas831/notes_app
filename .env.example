#Redis
REDIS_HOST = redis
REDIS_PORT=6379
REDIS_PASSWORD=my_redis_password
REDIS_USER=my_user
REDIS_USER_PASSWORD=my_user_password

#Postgres
POSTGRES_DB=notes-app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
